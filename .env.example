# Names only: never put real credentials in this committed file.
# Copy to ignored .env.local for ISOLATED local development.
# npm scripts do not automatically load this file; see docs/CLAUDE_CODE_HANDOFF.md.
# Production values belong in the target host's secret manager.
NODE_ENV=development

# Required for server startup. Current driver expects a Neon-compatible endpoint,
# not an arbitrary plain PostgreSQL URL. Use a disposable development database.
DATABASE_URL=

# Supply unique local secrets. For a production migration, preserve the effective
# existing ENCRYPTION_KEY; do not generate a replacement and lose decryption.
SESSION_SECRET=
ENCRYPTION_KEY=

# SMS login, inbound messages and outbound replies.
# Leave live credentials unset for initial development; use test-owned resources.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI: NEW_OPENAI_API_KEY is preferred, OPENAI_API_KEY is the fallback.
# Initial local checks must not use live billing credentials.
NEW_OPENAI_API_KEY=
OPENAI_API_KEY=

# Existing AWS S3 media storage. Use isolated development media/resources.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
# Optional permanent asset URL; preserve existing URL/key conventions.
S3_ASSET_BASE_URL=

# Link-preview providers.
MICROLINK_API_KEY=
TMDB_API_KEY=

# Server-side Pendo; omit during initial local checks to avoid live telemetry.
PENDO_TRACK_SECRET_KEY=

# Only if the Squarespace signup integration remains in use.
SQUARESPACE_DOMAIN=
SQUARESPACE_WEBHOOK_SECRET=

# Intentionally absent: Replit connection tokens, GITHUB_TOKEN, GIT_URL,
# REPLIT_DOMAINS, legacy NEON_DATABASE_URL/MIXPANEL_TOKEN.
# These are not substitutes for the current runtime variables above.
#
# PORT and a worker/cron-disable switch are NOT implemented in current startup.
# Do not assume adding invented flags here changes application behavior.
